{% extends 'base.html.twig' %}

{% block title %}Apperçu DPGF{% endblock %}

{% block body %}
    <h1>Apperçu DPGF</h1>

    <div class="divButton">
    
    <a class="btn btn-primary" href="{{ path('dpgf_newLigne', {'idCctp': cctp_id}) }}" role="button">Ajouter Ligne</a>
    <a class="btn btn-primary" href="{{ path('cctp_show', {'id': cctp_id}) }}" role="button">Retour Cctp</a>
    <a class="btn btn-secondary" href="{{ path('admin_home') }}" role="button">Retour à l'accueil</a>
    </div>

    <div class="container">
        {% for message in app.flashes('message')%}
            <div class="alert alert-success" role="alert">{{ message }}</div>
        {% endfor %}
        {% if panier != null %}
        <h2>Lignes à ajouter</h2>

        <table class="table">
            <thead>
                <tr>
                    <th>Lot</th>
                    <th>Sysyteme</th>
                    <th>Designation</th>
                    <th>Unité</th>
                    <th>Qté Entreprise</th>
                    <th>Prix Moyen</th>
                    <th>actions</th>
                </tr>
            </thead>
            
                {% for ligneSess in panier %}
                <tr>
                    <th>{{ ligneSess['lot'] }}</th>
                    <th>{{ ligneSess['systeme'] }}</th>
                    <th>{{ ligneSess['descritpion'] }}</th>
                    <th>{{ ligneSess['unite'] }}</th>
                    <th>{{ ligneSess['quantite'] }}</th>
                    <th></th>
                    {% if ligneSess['id'] is defined  %}
                    <th><a href="{{ path('dpgf_supprime', {'id': ligneSess['id'], 'idCctp': cctp_id }) }}" class="btn btn-danger"><i class="fas fa-trash"></i></a></th>
                    {% else %}
                    <th></th>
                    {% endif %}
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% endif %}
        
        <table class="table">
            <thead>
                <tr>
                    <th>Lot</th>
                    <th>Sysyteme</th>
                    <th>Designation</th>
                    <th>Unité</th>
                    <th>Qté Entreprise</th>
                    <th>Prix Moyen</th>
                    <th>actions</th>
                </tr>
            </thead>
            <tbody>
            {% for prod in dpgf %}
                <tr>
                    <td>{{ prod.produit.lot.nomLot }}</td>
                    <td>{{ prod.produit.systeme.nomSysteme }}</td>
                    <td>{{ prod.produit.nomProduit }}</td>
                    <td>{{ prod.produit.unite }}</td>
                    <td>{{ prod.quantite }}</td>
                    <td>{{ prod.moyenne }} €</td>
                    <td>
                        <a class="btn btn-warning" href="{{ path('dpgf_edit', {'id': prod.id}) }}">Mise à jour</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        
    
    </div>
{% endblock %}