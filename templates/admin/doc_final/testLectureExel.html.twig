{% extends 'base.html.twig' %}

{% block title %}Read Exel{% endblock %}

{% block body %}

    <h2 class="titreExel">Eléments du devis "{{ devi.chantier }}"</h2>
    <div class="container">
    {% if prod != null %}
    <table class="table">
        <thead>
            <tr>
                <th>Numero</th>
                <th>Designation</th>
                <th>Qté</th>
                <th>Prix Unitaire</th>
                <th>Type ?</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
        
    {% for key, data in prod %}
        
            <tr>
                <td>{{ data[0] }}</td>
                <td>{{ data[1] }}</td>
                <td>{{ data[3] }}</td>
                <td>{{ data[4] }}</td>
                <td>{{ data[6] }}</td>
                <td><a class="btn btn-success" href="{{ path('lignedevis_new_exel', {'id': devi.id, 'data': key}) }}">Insérer ligne devis</a></td>
            </tr>   
        
    {% endfor %}
        </tbody>
    </table>
    {% else %}
        <p>Tous les éléments on étés enregistrés</p>
        <a class="btn btn-success" href="{{ path('devis_show', {'id': devi.id}) }}">Voir devis</a>
    {% endif %}
    </div>
{% endblock %}