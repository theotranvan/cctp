{% extends 'base.html.twig' %}

{% block title %}search Produit{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
{% endblock %}

{% block body %}
<h1>Recherche élément</h1>
    <div class="container">
        
        {{ form_start(form) }}
        {{ form_end(form) }}

        {% if prod != null %}
        <table class="table">
        <thead>
            <tr>
                <th>Produit</th>
                <th>Moyenne</th>
                <th>{{ "now"|date('Y') }}</th>
                <th>{{ ("now"|date('Y'))-1 }}</th>
                <th>{{ ("now"|date('Y'))-2 }}</th>
                <th>{{ ("now"|date('Y'))-3 }}</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>{{ prod }} {% if typeProd != null %} {{ typeProd }} {% endif %}</td>
                {% if moyenne != null %}
                    <td>{{ moyenne[1]|round(2) }} €</td>
                {% else %}
                    <td>no records found</td>
                {% endif %}
                {% if year["now"|date('Y')] is defined %}
                    <td>{{ year["now"|date('Y')]|round(2) }} €</td>
                {% else %}
                    <td>-</td>
                {% endif %}
                {% if year["now"|date('Y')-1] is defined %}
                    <td>{{ year["now"|date('Y')-1]|round(2) }} €</td>
                {% else %}
                    <td>-</td>
                {% endif %}
                {% if year["now"|date('Y')-2] is defined %}
                    <td>{{ year["now"|date('Y')-2]|round(2) }} €</td>
                {% else %}
                    <td>-</td>
                {% endif %}
                {% if year["now"|date('Y')-3] is defined %}
                    <td>{{ year["now"|date('Y')-3]|round(2) }} €</td>
                {% else %}
                    <td>-</td>
                {% endif %}
            </tr>
        </tbody>
        </table>
        <table class="table">
        <thead>
            <tr>
                
                <th>Usage</th>
                <th>Marque</th>
                <th>Chantier</th>
                <th>Nom Installateur</th>
                <th>Quantite</th>
                <th>Prix Unitaire</th>
                <th>Prix Total</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                
            {% if infoProd != null %}
            

            {% for info in infoProd %}
            
                <td>{{ info.devis.chantier.typeusage }}</td>
                <td>{{ info.specification.marque }}</td>
                <td>{{ info.devis.chantier }}</td>
                <td>{{ info.devis.entreprise.role }}</td>
                <td>{{ info.quantite }}</td>
                <td>{{ info.specification.prixunitaire }} €</td>
                <td>{{ info.specification.prixunitaire * info.quantite }} €</td>
                <td>{{ info.devis.createdAt ? info.devis.createdAt|date('d-m-Y') : ''}}</td>
            </tr>
            {% endfor %}
            
            {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
            {% endif %}  
        </tbody>
    </table>
        {% endif %}
        <a class="btn btn-secondary" href="{{ path('admin_home') }}" role="button">Retour à l'accueil</a>
    </div>
{% endblock %}
{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="{{ asset('js/select22.js') }}"></script>
{% endblock %}