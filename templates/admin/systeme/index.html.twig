{% extends 'base.html.twig' %}
{% block title %}Systèmes{% endblock %}
{% block page_title %}<i class="bi bi-gear me-2 text-primary"></i>Systèmes{% endblock %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
<nav aria-label="breadcrumb"><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Accueil</a></li><li class="breadcrumb-item active">Systèmes</li></ol></nav>
<a href="{{ path('systeme_new') }}" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Nouveau</a>
</div>
<div class="card"><div class="card-body p-0">
{% if systemes is empty %}
<div class="text-center py-5 text-muted"><i class="bi bi-gear display-4 d-block mb-3 opacity-25"></i><p>Aucun Système trouvé.</p><a href="{{ path('systeme_new') }}" class="btn btn-primary">Créer</a></div>
{% else %}
<div class="table-responsive"><table class="table table-hover mb-0">
<thead><tr><th>Nom</th><th class="text-end">Actions</th></tr></thead>
<tbody>{% for systeme in systemes %}<tr>
<td class="fw-semibold">{{ systeme.nomSysteme }}</td>
<td class="text-end"><div class="btn-group btn-group-sm">
<a href="{{ path('systeme_edit', {id: systeme.id}) }}" class="btn btn-outline-secondary"><i class="bi bi-pencil"></i></a>
<button type="button" class="btn btn-outline-danger" onclick="if(confirm('Supprimer ?')) document.getElementById('del-systeme-{{ systeme.id }}').submit()"><i class="bi bi-trash"></i></button>
</div>
<form id="del-systeme-{{ systeme.id }}" method="post" action="{{ path('systeme_delete', {id: systeme.id}) }}" class="d-none"><input type="hidden" name="_token" value="{{ csrf_token('delete' ~ systeme.id) }}"></form>
</td></tr>{% endfor %}</tbody>
</table></div>
{% endif %}
</div></div>
{% endblock %}
