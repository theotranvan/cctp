{% extends 'base.html.twig' %}

{% block title %}Systeme{% endblock %}

{% block body %}
    <h1>Systeme</h1>

    <div class="divButtonEditCctp">
        <a class="btn btn-primary" href="{{ path('systeme_index') }}" role="button">Retour liste Système</a>
        <a class="btn btn-warning" href="{{ path('systeme_edit', {'id': systeme.id}) }}">Mettre à jour</a>
        <a class="btn btn-secondary" href="{{ path('admin_home') }}" role="button">Retour à l'accueil</a> 
    </div>

    <div class="container">
    <table class="table">
        <tbody>
            <tr>
