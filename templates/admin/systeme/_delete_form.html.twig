<form method="post" action="{{ path('systeme_delete', {'id': systeme.id}) }}" onsubmit="return confirm('Etes-vous sûr de vouloir supprimer ce système?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ systeme.id) }}">
    <button class="btn btn-outline-danger">Supprimer</button>
</form>
