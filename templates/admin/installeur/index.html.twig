{% extends 'base.html.twig' %}

{% block title %}Liste Installeurs{% endblock %}

{% block body %}
    <h1>Liste Installeurs</h1>
    <div class="container">
    {% for message in app.flashes('message')%}
    <div class="alert alert-success" role="alert">{{ message }}</div>
    {% endfor %}

    <div class="divButton">
        <a class="btn btn-primary" href="{{ path('installeur_new') }}">Nouveau Installeur</a>
        <a class="btn btn-secondary" href="{{ path('admin_home') }}" role="button">Retour à l'acceuil</a>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom_installeur</th>
                <th>Tel</th>
                <th>Mail</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for installeur in installeurs %}
            <tr>
                <td>{{ installeur.id }}</td>
                <td>{{ installeur.nomInstalleur }}</td>
                <td>{{ installeur.tel }}</td>
                <td>{{ installeur.mail }}</td>
                <td>
                    <a class="btn btn-primary" href="{{ path('installeur_show', {'id': installeur.id}) }}">Voir</a>
                    <a class="btn btn-warning" href="{{ path('installeur_edit', {'id': installeur.id}) }}">Mise à jour</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    
    </div>
{% endblock %}
