<form method="post" action="{{ path('installeur_delete', {'id': installeur.id}) }}" onsubmit="return confirm('Etes-vous sûr de vouloir supprimer cet installeur?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ installeur.id) }}">
    <button class="btn btn-danger">Supprimer</button>
</form>
