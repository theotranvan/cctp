{% extends 'base.html.twig' %}

{% block title %}Installeur{% endblock %}

{% block body %}
    <h1>Installeur</h1>

    <div class="divButtonEditCctp">
        <a class="btn btn-primary" href="{{ path('installeur_index') }}">Retour liste Installeurs</a>
        <a class="btn btn-warning" href="{{ path('installeur_edit', {'id': installeur.id}) }}">Mise à jour</a>
        <a class="btn btn-secondary" href="{{ path('admin_home') }}" role="button">Retour à l'acceuil</a>
    </div>

    <div class="container">
    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ installeur.id }}</td>
            </tr>
            <tr>
                <th>Nom_installeur</th>
                <td>{{ installeur.nomInstalleur }}</td>
            </tr>
            <tr>
                <th>Tel</th>
                <td>{{ installeur.tel }}</td>
            </tr>
            <tr>
                <th>Mail</th>
                <td>{{ installeur.mail }}</td>
            </tr>
        </tbody>
    </table>
    {{ include('admin/installeur/_delete_form.html.twig') }}
    </div>
{% endblock %}
