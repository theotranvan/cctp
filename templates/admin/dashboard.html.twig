{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - CCTP Manager{% endblock %}
{% block page_title %}<i class="bi bi-speedometer2 me-2 text-primary"></i>Tableau de bord{% endblock %}

{% block body %}
<!-- Stats row -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:#dbeafe;color:#2563eb;">
                    <i class="bi bi-file-earmark-text"></i>
                </div>
                <div>
                    <div class="h3 fw-bold mb-0">{{ stats.cctps }}</div>
                    <div class="text-muted small">CCTPs total</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:#dcfce7;color:#16a34a;">
                    <i class="bi bi-file-check"></i>
                </div>
                <div>
                    <div class="h3 fw-bold mb-0">{{ stats.cctps_open }}</div>
                    <div class="text-muted small">CCTPs en cours</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:#fef9c3;color:#ca8a04;">
                    <i class="bi bi-box"></i>
                </div>
                <div>
                    <div class="h3 fw-bold mb-0">{{ stats.produits }}</div>
                    <div class="text-muted small">Produits catalogue</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:#fce7f3;color:#be185d;">
                    <i class="bi bi-receipt"></i>
                </div>
                <div>
                    <div class="h3 fw-bold mb-0">{{ stats.devis }}</div>
                    <div class="text-muted small">Devis créés</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent CCTPs -->
<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <span><i class="bi bi-clock-history me-2 text-primary"></i>CCTPs récents</span>
        <a href="{{ path('cctp_index') }}" class="btn btn-sm btn-primary">
            <i class="bi bi-plus me-1"></i>Nouveau CCTP
        </a>
    </div>
    <div class="card-body p-0">
        {% if recent_cctps is empty %}
            <div class="text-center py-5 text-muted">
                <i class="bi bi-file-earmark-text display-4 d-block mb-3 opacity-25"></i>
                <p>Aucun CCTP créé pour le moment.</p>
                <a href="{{ path('cctp_new') }}" class="btn btn-primary">Créer le premier CCTP</a>
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>N° Affaire</th>
                            <th>Titre</th>
                            <th>Opération</th>
                            <th>Statut</th>
                            <th>Créé le</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for cctp in recent_cctps %}
                        <tr>
                            <td><span class="badge bg-light text-dark fw-bold">{{ cctp.numAffaire }}</span></td>
                            <td class="fw-semibold">{{ cctp.titre }}</td>
                            <td class="text-muted">{{ cctp.nomOperation }}</td>
                            <td>
                                {% if cctp.close %}
                                    <span class="badge badge-closed px-2 py-1 rounded-pill">Clôturé</span>
                                {% else %}
                                    <span class="badge badge-open px-2 py-1 rounded-pill">En cours</span>
                                {% endif %}
                            </td>
                            <td class="text-muted small">{{ cctp.createdAt ? cctp.createdAt|date('d/m/Y') : '' }}</td>
                            <td>
                                <a href="{{ path('cctp_show', {id: cctp.id}) }}" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
