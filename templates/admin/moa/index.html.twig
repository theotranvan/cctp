{% extends 'base.html.twig' %}

{% block title %}Liste des MOA{% endblock %}

{% block body %}
    <h1>Liste des MOA</h1>
    <div class="container">
    {% for message in app.flashes('message')%}
    <div class="alert alert-success" role="alert">{{ message }}</div>
    {% endfor %}

    <div class="divButton">
        <a class="btn btn-primary" href="{{ path('moa_new') }}" role="button">Nouveau MOA</a>
        <a class="btn btn-secondary" href="{{ path('admin_home') }}" role="button">Retour à l'acceuil</a>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom_moa</th>
                <th>Prenom_moa</th>
                <th>Tel_moa</th>
                <th>Mail_moa</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for moa in moas %}
            <tr>
                <td>{{ moa.id }}</td>
                <td>{{ moa.nomMoa }}</td>
                <td>{{ moa.prenomMoa }}</td>
                <td>{{ moa.telMoa }}</td>
                <td>{{ moa.mailMoa }}</td>
                <td>
                    <a class="btn btn-primary" href="{{ path('moa_show', {'id': moa.id}) }}" role="button">Voir</a>
                    <a class="btn btn-warning" href="{{ path('moa_edit', {'id': moa.id}) }}" role="button">Mettre à jour</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
    
{% endblock %}
