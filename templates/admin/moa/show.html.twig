{% extends 'base.html.twig' %}

{% block title %}Moa{% endblock %}

{% block body %}
    <h1>Moa</h1>

    <div class="divButtonEditCctp">
        <a class="btn btn-primary" href="{{ path('moa_index') }}" role="button">Retour liste MOA</a>
        <a class="btn btn-warning" href="{{ path('moa_edit', {'id': moa.id}) }}" role="button">Mettre à jour</a>
        <a class="btn btn-secondary" href="{{ path('admin_home') }}" role="button">Retour à l'acceuil</a>
    </div>

    <div class="container">
    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ moa.id }}</td>
            </tr>
            <tr>
                <th>Nom_moa</th>
                <td>{{ moa.nomMoa }}</td>
            </tr>
            <tr>
                <th>Prenom_moa</th>
                <td>{{ moa.prenomMoa }}</td>
            </tr>
            <tr>
                <th>Tel_moa</th>
                <td>{{ moa.telMoa }}</td>
            </tr>
            <tr>
                <th>Mail_moa</th>
                <td>{{ moa.mailMoa }}</td>
            </tr>
        </tbody>
    </table>
    {{ include('admin/moa/_delete_form.html.twig') }}
    </div>
{% endblock %}
