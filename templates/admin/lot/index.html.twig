{% extends 'base.html.twig' %}

{% block title %}Liste des lots{% endblock %}

{% block body %}
    <h1>Liste des lots</h1>

    <div class="divButton">
        <a class="btn btn-primary" href="{{ path('lot_new') }}" role="button">Créer nouveau lot</a>
        <a class="btn btn-secondary" href="{{ path('admin_home') }}" role="button">Retour à l'accueil</a>
    </div>

    <div class="container">
    {% for message in app.flashes('message')%}
    <div class="alert alert-success" role="alert">{{ message }}</div>
    {% endfor %}
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom_lot</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for lot in lots %}
            <tr>
                <td>{{ lot.id }}</td>
                <td>{{ lot.nomLot }}</td>
                <td>
                    <a class="btn btn-primary" href="{{ path('lot_show', {'id': lot.id}) }}" role="button">Voir</a>
                    <a class="btn btn-warning" href="{{ path('lot_edit', {'id': lot.id}) }}">Mettre à jour</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
    
{% endblock %}
