{% extends 'base.html.twig' %}

{% block title %}Lot{% endblock %}

{% block body %}
    <h1>Lot</h1>
    
    <div class="divButtonEditCctp">
        <a class="btn btn-primary" href="{{ path('lot_index') }}" role="button">Retour liste Lots</a>
        <a class="btn btn-warning" href="{{ path('lot_edit', {'id': lot.id}) }}">Mettre à jour</a>
        {{ include('admin/lot/_delete_form.html.twig') }}
        <a class="btn btn-secondary" href="{{ path('admin_home') }}" role="button">Retour à l'accueil</a>
    </div>
    <div class="container">
        <table class="table">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ lot.id }}</td>
                </tr>
                <tr>
                    <th>Nom_lot</th>
                    <td>{{ lot.nomLot }}</td>
                </tr>
            </tbody>
        </table>
    </div>
    
    
{% endblock %}
