{% extends 'base.html.twig' %}

{% block title %}Page d'acceuil Combiosol{% endblock %}

{% block body %}
<div class="container">
{% for message in app.flashes('message')%}
    <div class="alert alert-success" role="alert">{{ message }}</div>
{% endfor %}
<div class="navbar">

<ul class="nav flex-column">
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">CCTP</a>
        <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="{{ path('cctp_new') }}">Créer</a></li>
            <li><a class="dropdown-item" href="{{ path('cctp_index') }}">Rechercher</a></li>
        </ul>
    </li>
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">Chantier</a>
        <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="{{ path('chantier_new') }}">Insérer nouveau Chantier</a></li>
            <li><a class="dropdown-item" href="{{ path('chantier_index') }}">rechercher Chantier</a></li>
        </ul>
    </li>
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">Devis</a>
        <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="{{ path('devis_new') }}">Insérer nouveau Devis</a></li>
            <li><a class="dropdown-item" href="{{ path('devis_index') }}">Rechercher Devis</a></li>
            <li><a class="dropdown-item" href="{{ path('lignedevis_index') }}">Rechercher Element</a></li>
            <li><a class="dropdown-item" href="{{ path('estimation') }}">Estimation rapide</a></li>
        </ul>
    </li>
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">Contacts</a>
        <ul class="dropdown-menu">
            
            <li><a class="dropdown-item" href="{{ path('entreprise_index') }}">Entreprises</a></li>
        </ul>
    </li>
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">Eléments</a>
        <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="{{ path('lot_index') }}">Lots</a></li>
            <li><a class="dropdown-item" href="{{ path('systeme_index') }}">Systèmes</a></li>
            <li><a class="dropdown-item" href="{{ path('produit_index') }}">Eléments</a></li>
        </ul>
    </li>
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">Utilisateurs</a>
        <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="{{ path('app_register') }}">Créer</a></li>
            <li><a class="dropdown-item" href="{{ path('utilisateur_index') }}">Rechercher</a></li>
        </ul>
    </li>
</ul>
{% if app.user %}
        <div class="mb-3 hello">
            <h3>BONJOUR</h3>
            <h4>{{ app.user.prenomUser|upper }} {{ app.user.nomUser|upper }}</h4>
            <img src="{{ asset("/uploads/LogoAcceuilCombiosol.png") }}" class="background-page" alt="logo Combiosol">
            <p><a class="btn btn-outline-danger" href="{{ path('app_logout') }}">Déconnexion</a></p>
            
        </div>
        
    {% endif %}
</div>
</div>
{% endblock %}
