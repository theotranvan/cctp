{% extends 'base.html.twig' %}

{% block title %}Devis{% endblock %}

{% block body %}
    <h1>Devis</h1>
    <div class="container">
    {% for message in app.flashes('message')%}
    <div class="alert alert-success" role="alert">{{ message }}</div>
    {% endfor %}
    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ devi.id }}</td>
            </tr>
            <tr>
                <th>Date de création</th>
                <td>{{ devi.createdAt ? devi.createdAt|date('d-m-Y') : '' }}</td>
            </tr>
            <tr>
                <th>Installeur</th>
                <td>{{ devi.installeur }}</td>
            </tr>
            <tr>
                <th>Chantier</th>
                <td>{{ devi.chantier }}</td>
            </tr>
            <tr>
                <th>Usage</th>
                <td>{{ devi.chantier.typeusage }}</td>
            </tr>
            <tr>
                <th>Surface</th>
                <td>{{ devi.chantier.surface }}</td>
            </tr>
        </tbody>
    </table>


    <div class="btnShow">
    <a class="btn btn-success" href="{{ path('lignedevis_new', {'id': devi.id}) }}">Insérer ligne devis</a>

    <a class="btn btn-primary" href="{{ path('devis_index') }}">Retour liste Devis</a>

    <a class="btn btn-warning" href="{{ path('devis_edit', {'id': devi.id}) }}">Mise à jour</a>

    {{ include('admin/devis/_delete_form.html.twig') }}

    <a class="btn btn-secondary" href="{{ path('admin_home') }}" role="button">Retour à l'accueil</a>
    
    </div>

    
    
    <table class="table">
        <thead>
            <tr>
                <th>Nom Produit</th>
                <th>Quantite</th>
                <th>Marque</th>
                <th>Type</th>
                <th>Prix Unitaire</th>
                <th>Prix Total</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        
        {% for lignedevi in lignedevis %}
            <tr>
                <td>{{ lignedevi.produit }}</td>
                <td>{{ lignedevi.quantite }}</td>
                <td>{{ lignedevi.specification.marque }}</td>
                <td>{{ lignedevi.specification.type }}</td>
                <td>{{ lignedevi.specification.prixunitaire }} €</td>
                <td>{{ lignedevi.quantite * lignedevi.specification.prixunitaire }} €</td>
                <td>
                    <div class="divForm">
                        <a class="btn btn-warning" href="{{ path('lignedevis_edit', {'id': lignedevi.id}) }}"><i class="fas fa-pen"></i></a>
                        {{ include('admin/lignedevis/_delete_form.html.twig') }}
                    </div>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>

    
{% endblock %}
