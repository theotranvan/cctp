{% extends 'base.html.twig' %}

{% block title %}Liste Devis{% endblock %}

{% block body %}
    <h1>Liste Devis</h1>

    <div class="divButton">
        <a class="btn btn-primary" href="{{ path('devis_new') }}">Insérer nouveau Devis</a>
        <a class="btn btn-secondary" href="{{ path('admin_home') }}" role="button">Retour à l'accueil</a>
    </div>

    <div class="container">
        {% for message in app.flashes('message')%}
            <div class="alert alert-success" role="alert">{{ message }}</div>
        {% endfor %}

        {{ form_start(form) }}
        {{ form_end(form) }}
    
        {% if usage != null %}
        <table class="table">
            <thead>
                <tr>
                    <th>CreatedAt</th>
                    <th>Chantier</th>
                    <th>Surface</th>
                    <th>Usage</th>
                    <th>Installeur</th>
                    <th>actions</th>
                </tr>
            </thead>
            <tbody>
            {% for devi in devis %}
            {% if devi.chantier.typeusage == usage %}
                <tr>
                    <td>{{ devi.createdAt ? devi.createdAt|date('d-m-Y') : '' }}</td>
                    <td>{{ devi.chantier }}</td>
                    <td>{{ devi.chantier.surface }}</td>
                    <td>{{ devi.chantier.typeusage }}</td>
                    <td>{{ devi.entreprise }}</td>
                    <td>
                        <a class="btn btn-primary" href="{{ path('devis_show', {'id': devi.id}) }}">Voir</a>
                        <a class="btn btn-warning" href="{{ path('devis_edit', {'id': devi.id}) }}">Mise à jour</a>
                    </td>
                </tr>
            {% endif %}
            {% else %}
                <tr>
                    <td colspan="3">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        {% endif %}
    </div>
{% endblock %}

