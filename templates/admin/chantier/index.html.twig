{% extends 'base.html.twig' %}

{% block title %}Liste Chantier{% endblock %}

{% block body %}
    <h1>Liste Chantier</h1>

    <div class="divButton">
    <a class="btn btn-primary" href="{{ path('chantier_new') }}">Créer nouveau chantier</a>
    <a class="btn btn-secondary" href="{{ path('admin_home') }}" role="button">Retour à l'accueil</a>
    </div>

    <div class="container">
        {% for message in app.flashes('message')%}
            <div class="alert alert-success" role="alert">{{ message }}</div>
        {% endfor %}
        
        <table class="table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nom_chantier</th>
                    <th>Type Usage</th>
                    <th>Surface</th>
                    <th>Type_lgt</th>
                    <th>Nb_lgt</th>
                    <th>actions</th>
                </tr>
            </thead>
            <tbody>
            {% for chantier in chantiers %}
                <tr>
                    <td>{{ chantier.id }}</td>
                    <td>{{ chantier.nomChantier }}</td>
                    <td>{{ chantier.typeusage }}</td>
                    <td>{{ chantier.surface }}</td>
                    <td>{{ chantier.typeLgt }}</td>
                    <td>{{ chantier.nbLgt }}</td>
                    <td>
                        <a class="btn btn-primary" href="{{ path('chantier_show', {'id': chantier.id}) }}">Voir</a>
                        <a class="btn btn-warning" href="{{ path('chantier_edit', {'id': chantier.id}) }}">Mise à jour</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    
    </div>
{% endblock %}
