<form method="post" action="{{ path('chantier_delete', {'id': chantier.id}) }}" onsubmit="return confirm('Etes-vous sûr de vouloir supprimer ce chantier?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ chantier.id) }}">
    <button class="btn btn-danger">Supprimer</button>
</form>
