{% extends 'base.html.twig' %}

{% block title %}Chantier{% endblock %}

{% block stylesheet %}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.4/Chart.min.css" integrity="sha512-/zs32ZEJh+/EO2N1b0PEdoA10JkdC3zJ8L5FTiQu82LR9S/rOQNfQN7U59U9BC12swNeRAz3HSzIL2vpp4fv3w==" crossorigin="anonymous" referrerpolicy="no-referrer" />
{% endblock %}

{% block body %}
    <h1>Chantier</h1>
    <div class="divButtonEditCctp">
        <a class="btn btn-primary" href="{{ path('chantier_index') }}">Retour liste chantier</a>
        <a class="btn btn-warning" href="{{ path('chantier_edit', {'id': chantier.id}) }}">Mise à jour</a>
        <a class="btn btn-secondary" href="{{ path('admin_home') }}" role="button">Retour à l'accueil</a>
    </div>
    
    <div class="container">
    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ chantier.id }}</td>
            </tr>
            <tr>
                <th>Nom_chantier</th>
                <td>{{ chantier.nomChantier }}</td>
            </tr>
            <tr>
                <th>Surface</th>
                <td>{{ chantier.surface }}</td>
            </tr>
            <tr>
                <th>Type_lgt</th>
                <td>{{ chantier.typeLgt }}</td>
            </tr>
            <tr>
                <th>Nb_lgt</th>
                <td>{{ chantier.nbLgt }}</td>
            </tr>
            
        </tbody>
    </table>
    <div class="canvas">
    <div class="nbElemByI"></div>
    <canvas id="prixTotal" width="200" height="200"></canvas> 
    </div>

    {{ include('admin/chantier/_delete_form.html.twig') }}
    </div>
{% endblock %}
{% block javascripts %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.4/Chart.min.js" integrity="sha512-d9xgZrVZpmmQlfonhQUvTR7lMPtO7NkZMkA0ABN3PHCbKA5nqylQ/yWlFAyY6hYgdF1Qh6nYiuADWwKB4C2WSw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        window.onload = function() {
        var prixTbyInstal = document.querySelector('#prixTotal')
        var nbElemByI = document.querySelector('.nbElemByI')
        //console.log({{nbElem|raw}})
        var prixGraph = new Chart(prixTbyInstal, {
            type: "bar",
            data: {
                labels: {{ nomInstal|raw }},
                datasets: [{
                    label: "Prix total par installateur",
                    data: {{ prixT|raw }}

                }]

            }
        })
        }
    </script>
{% endblock %}
