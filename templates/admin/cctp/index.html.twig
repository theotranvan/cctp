{% extends 'base.html.twig' %}

{% block title %}Liste des Cctp{% endblock %}

{% block body %}
    <h1>Liste des Cctp</h1>

    <div class="divButton">
        <a class="btn btn-primary" href="{{ path('cctp_new') }}">Créer nouveau Cctp</a>
        <a class="btn btn-secondary" href="{{ path('admin_home') }}" role="button">Retour à l'accueil</a>
    </div>

    <!--<div class="container">-->
        {% for message in app.flashes('message')%}
            <div class="alert alert-success" role="alert">{{ message }}</div>
        {% endfor %}
        <table class="table">
            <thead>
                <tr>
                    <th>Num Affaire</th>
                    <th>Titre</th>
                    <th>Moa</th>
                    <th>Moe</th>
                    <th>actions</th>
                    <th>Fait</th>
                </tr>
            </thead>
            <tbody>
            {% for cctp in cctps %}
                <tr>
                    
                    <td>{{ cctp.numAffaire }}</td>
                    <td>{{ cctp.titre }}</td> 
                    {% if cctp.entreprise|length > 1 %}
                        {% for entreprise in cctp.entreprise %}
                            {% if entreprise.role == "MOA" %}
                                <td>{{ entreprise }}</td>
                            {% endif %}
                        {% endfor %}
                        {% for entreprise in cctp.entreprise %}
                            {% if entreprise.role == "MOE" %}
                                <td>{{ entreprise }}</td>
                            {% endif %}
                        {% endfor %}
                    {% else %}
                        {% for entreprise in cctp.entreprise %}
                        {% if entreprise.role == "MOA" %}
                            <td>{{ entreprise }}</td>
                            <td>" "</td>
                        {% else %}
                            <td> </td>
                            <td>{{ entreprise }}</td>
                        {% endif %}
                        {% endfor %}
                    {% endif %}
            
                    <td>
                        <a class="btn btn-primary" href="{{ path('cctp_show', {'id': cctp.id}) }}" role="button"><i class="fas fa-eye"></i></a>
                        <a class="btn btn-warning" href="{{ path('cctp_edit', {'id': cctp.id}) }}"><i class="fas fa-pen"></i></a>
                        <a id="{{ cctp.id }}" class="btn btn-success" href="{{ path('cctp_okdoc', {'id': cctp.id}) }}" role="button"><i class="fas fa-print"></i></a>
                        <br class="clearBoth" />
                    </td>
                    <td>
                        <div class="form-check form-switch aligner inline">
                            <input class="form-check-input" type="checkbox" {{ (cctp.close) ? 'checked' : ''}} data-id="{{ cctp.id }}" id="flexSwitchCheckDefault">
                            <label class="form-check-label" for="flexSwitchCheckDefault">Fini</label>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    <!--</div>-->
    
{% endblock %}
{% block javascripts %}
    <script src="{{ asset('js/color.js') }}"></script>
{% endblock %}
