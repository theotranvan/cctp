{% extends 'base.html.twig' %}

{% block title %}éléments du Cctp{% endblock %}

{% block body %}
    <h1>Eléments du Cctp {{ cctp.titre }}</h1>

    <div class="divButton">
        <a class="btn btn-primary" href="{{ path('cctp_index') }}" role="button">Retour liste Cctp</a>
    </div>

    <div class="container">
        
            <p>Choisissez les éléments pour les lots suivants : 
                <ol>
                    {% for lot in cctp.lotCctp %} 
                        <li>{{ lot }}</li> 
                    {% endfor %}
                </ol>
            </p>


        {{ form_start(form) }}
        
        <div class="formProd">
            <div class="listProd1">
                {{ form_row(form.produits) }}
            </div>
            {% if form.produits1 is defined %}
            <div class="listProd2">
                {{ form_row(form.produits1) }}
            </div>
            {% endif %}

            {% if form.produits2 is defined %}
            <div class="listProd3">
                {{ form_row(form.produits2) }}
            </div>
            {% endif %}

            {% if form.produits3 is defined %}
            <div class="listProd4">
                {{ form_row(form.produits3) }}
            </div>
            {% endif %}

            {% if form.produits4 is defined %}
            <div class="listProd5">
                {{ form_row(form.produits4) }}
            </div>
            {% endif %}

            {% if form.produits5 is defined %}
            <div class="listProd6">
                {{ form_row(form.produits5) }}
            </div>
            {% endif %}
        </div>
        {{ form_end(form) }}
    </div>
    
{% endblock %}