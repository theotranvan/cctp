{% extends 'base.html.twig' %}

{% block title %}Nouveau Cctp{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
{% endblock %}

{% block body %}
    <h1>Créer nouveau Cctp</h1>

    <div class="divButtonCctp">
        <a class="btn btn-secondary" href="{{ path('cctp_index') }}" role="button">Retour liste des Cctp</a>
        <a class="btn btn-primary" href="{{ path('entreprise_new') }}" role="button">Nouvelle entreprise</a>
        <a class="btn btn-secondary" href="{{ path('admin_home') }}" role="button">Retour à l'accueil</a>
    </div>

    <div class="container">
        {{ include('admin/cctp/_form.html.twig') }}
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="{{ asset('js/select2.js') }}"></script>
{% endblock %}
