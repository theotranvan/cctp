{% extends 'base.html.twig' %}

{% block title %}éléments du Cctp{% endblock %}

{% block body %}
    <h1>Eléments du Cctp {{ cctp.titre }}</h1>

    <div class="divButton">
        <a class="btn btn-primary" href="{{ path('cctp_index') }}" role="button">Retour liste Cctp</a>
    </div>

    <div class="container">
        {% if cctp.lotCctp[1] is defined and cctp.lotCctp[1] != null %}
            <p>Choisissez les éléments pour les lots suivants : <ol>{% for lot in cctp.lotCctp %} <li>{{ lot }} <a href="{{ path('cctp_ajout_prod_by_lot', {'cctpId': cctp.id, 'lot': lot.id }) }}" class="btn btn-warning">Choisir</a></li> {% endfor %}</ol></p>
        {% else %}
            <p>Choisissez les éléments pour le lot {{cctp.lotCctp[0] }} <a href="{{ path('cctp_ajout_prod_by_lot', {'cctpId': cctp.id, 'lot': cctp.lotCctp[0] }) }}" class="btn btn-warning">Choisir</a></p>
        {% endif %}
    </div>
    
{% endblock %}