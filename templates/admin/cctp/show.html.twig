        <div class="table-responsive col-md-6">
            <h2>{{ cctp.lotCctp[0] }}</h2>
            {% for systeme in cctp.lotCctp[0].systemes %}
            
            <table class="table">
                <thead>
                    <tr>
                        <th>Elémént(s) du système {{ systeme.nomsysteme }}</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for produit in cctp.produits %}
                    {% if produit.lot == cctp.lotCctp[0] and produit.systeme == systeme %}

                    <tr>
                        <td>{{ produit }} {% if produit|slice(0,6) != "Normes" %}{% set countAjout = 0 %} {% for docs in
                            produit.docfinals %}{% if docs.cctpId == cctp.id %} {% set countAjout = countAjout + 1 %} {%
                            endif %}{% endfor %} <span class="green">({{ countAjout }})</span>{% endif %}</td>
                        <td>
                            <a href="{{ path('cctp_remove_prod', {'id': produit.id, 'idCctp': cctp.id}) }}"
                                class="btn btn-danger"><i class="fas fa-trash"></i></a>
                            {% if produit.modifiable %}
                            <a href="{{ path('doc_final_new', {'id': produit.id, 'idCctp':cctp.id}) }}"
                                class="btn btn-warning"><i class="fas fa-pen"></i></a>
                            {% endif %}
                            {% if produit|slice(0,6) != "Normes" %}
                            <a href="{{ path('doc_final_dpgf', {'id': produit.id, 'idCctp':cctp.id}) }}"
                                class="btn btn-warning">Qté</a>
                            {% endif %}
                        </td>
                    </tr>
                    {% endif %}
