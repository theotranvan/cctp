{% extends 'base.html.twig' %}

{% block title %}Cctp{% endblock %}

{% block body %}
<h1>Cctp {{ cctp.titre }}</h1>

<div class="container">
    {% for message in app.flashes('message')%}
    <div class="alert alert-success" role="alert">{{ message }}</div>
    {% endfor %}
    {# tableau qui affiche les informations principales du cctp #}
    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ cctp.id }}</td>
            </tr>
            <tr>
                <th>Num Affaire</th>
                <td>{{ cctp.numAffaire }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ cctp.titre }}</td>
            </tr>
            <tr>
                <th>Moa</th>
                {% for entreprise in cctp.entreprise %}
                {% if entreprise.role == "MOA" %}
                <td>{{ entreprise }}</td>
                {% endif %}
                {% endfor %}
            </tr>
            <tr>
                <th>Moe</th>
                {% for entreprise in cctp.entreprise %}
                {% if entreprise.role == "MOE" %}
                <td>{{ entreprise }}</td>
                {% endif %}
                {% endfor %}
            </tr>
            <tr>
                <th>Lot(s)</th>
                {% for lotCctp in cctp.lotCctp %}
                <td>{{ lotCctp }}</td>
                {% endfor %}
            </tr>
        </tbody>
    </table>

    <p>Eléments(s)</p>
    {# s'il y'a 6 lots #}
    {% if cctp.lotCctp[5] is defined and cctp.lotCctp[5] != null  %}
