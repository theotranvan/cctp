{% extends 'base.html.twig' %}
{% block title %}Utilisateurs{% endblock %}
{% block page_title %}<i class="bi bi-people me-2 text-primary"></i>Utilisateurs{% endblock %}
{% block body %}
<nav aria-label="breadcrumb" class="mb-4"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Accueil</a></li><li class="breadcrumb-item active">Utilisateurs</li></ol></nav>
{% if 'edit' == 'index' %}
<div class="d-flex justify-content-end mb-3"><a href="{{ path('utilisateur_new') }}" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Nouvel utilisateur</a></div>
<div class="card"><div class="card-body p-0">
{% if utilisateurs is empty %}<div class="text-center py-5 text-muted"><p>Aucun utilisateur.</p></div>
{% else %}<div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Nom</th><th>Email</th><th>Rôles</th><th class="text-end">Actions</th></tr></thead>
<tbody>{% for u in utilisateurs %}<tr>
<td class="fw-semibold">{{ u.fullName }}</td><td>{{ u.email }}</td><td>{% for r in u.roles %}<span class="badge bg-light text-dark border me-1">{{ r }}</span>{% endfor %}</td>
<td class="text-end"><div class="btn-group btn-group-sm">
<a href="{{ path('utilisateur_edit', {id: u.id}) }}" class="btn btn-outline-secondary"><i class="bi bi-pencil"></i></a>
<a href="{{ path('utilisateur_change_password', {id: u.id}) }}" class="btn btn-outline-warning"><i class="bi bi-key"></i></a>
<button type="button" class="btn btn-outline-danger" onclick="if(confirm('Supprimer ?')) document.getElementById('del-u-{{ u.id }}').submit()"><i class="bi bi-trash"></i></button>
</div><form id="del-u-{{ u.id }}" method="post" action="{{ path('utilisateur_delete', {id: u.id}) }}" class="d-none"><input type="hidden" name="_token" value="{{ csrf_token('delete' ~ u.id) }}"></form></td></tr>{% endfor %}</tbody></table></div>
{% endif %}</div></div>
{% else %}
<div class="row justify-content-center"><div class="col-lg-7"><div class="card"><div class="card-header">Utilisateur</div>
<div class="card-body p-4">{{ form_start(form) }}{{ form_widget(form) }}<div class="d-flex gap-2 pt-3 border-top"><button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Enregistrer</button><a href="{{ path('utilisateur_index') }}" class="btn btn-outline-secondary">Annuler</a></div>{{ form_end(form) }}</div></div></div></div>
{% endif %}
{% endblock %}
