{% extends 'base.html.twig' %}

{% block title %}Liste Utilisateurs{% endblock %}

{% block body %}
    <h1>Liste Utilisateurs</h1>

    <div class="divButton">
        <a class="btn btn-primary" href="{{ path('app_register') }}">Créer nouveau Utilisateur</a>
        <a class="btn btn-secondary" href="{{ path('admin_home') }}" role="button">Retour à l'accueil</a>
    </div>
    
    <div class="container">
    
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Email</th>
                {#<th>Roles</th>#}
                {#<th>Password</th>#}
                <th>Nom_user</th>
                <th>Prenom_user</th>
                {#<th>IsVerified</th>#}
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for utilisateur in utilisateurs %}
            <tr>
                <td>{{ utilisateur.id }}</td>
                <td>{{ utilisateur.email }}</td>
                {#<td>{{ utilisateur.roles ? utilisateur.roles|json_encode : '' }}</td>#}
                {#<td>{{ utilisateur.password }}</td>#}
                <td>{{ utilisateur.nomUser }}</td>
                <td>{{ utilisateur.prenomUser }}</td>
                {#<td>{{ utilisateur.isVerified ? 'Yes' : 'No' }}</td>#}
                <td>
                    <a class="btn btn-primary" href="{{ path('utilisateur_show', {'id': utilisateur.id}) }}">Voir</a>
                    <a class="btn btn-warning" href="{{ path('utilisateur_edit', {'id': utilisateur.id}) }}">Mise à jour</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
    
{% endblock %}
