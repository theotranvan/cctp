{% extends 'base.html.twig' %}

{% block title %}Utilisateur{% endblock %}

{% block body %}
    <h1>Utilisateur</h1>

    <div class="divButtonEditCctp">
        <a class="btn btn-primary" href="{{ path('utilisateur_index') }}">Retour liste Utilisateurs</a>
        <a class="btn btn-warning" href="{{ path('utilisateur_edit', {'id': utilisateur.id}) }}">Mise à jour</a>
        <a class="btn btn-secondary" href="{{ path('admin_home') }}" role="button">Retour à l'accueil</a>
    </div>

    <div class="container">
    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ utilisateur.id }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ utilisateur.email }}</td>
            </tr>
            <tr>
                <th>Roles</th>
                <td>{{ utilisateur.roles ? utilisateur.roles|json_encode : '' }}</td>
            </tr>
            <tr>
                <th>Nom_user</th>
                <td>{{ utilisateur.nomUser }}</td>
            </tr>
            <tr>
                <th>Prenom_user</th>
                <td>{{ utilisateur.prenomUser }}</td>
            </tr>
            <tr>
                <th>IsVerified</th>
                <td>{{ utilisateur.isVerified ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>
    {{ include('admin/utilisateur/_delete_form.html.twig') }}
    </div>
{% endblock %}
