{% extends 'base.html.twig' %}

{% block title %}Liste des MOE{% endblock %}

{% block body %}
    <h1>Liste des MOE</h1>
    <div class="container">
    {% for message in app.flashes('message')%}
    <div class="alert alert-success" role="alert">{{ message }}</div>
    {% endfor %}

    <div class="divButton">
        <a class="btn btn-primary" href="{{ path('moe_new') }}" role="button">Créer nouveau MOE</a>
        <a class="btn btn-secondary" href="{{ path('admin_home') }}" role="button">Retour à l'acceuil</a>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom_moe</th>
                <th>Prenom_moe</th>
                <th>Tel_moe</th>
                <th>Mail_moe</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for moe in moes %}
            <tr>
                <td>{{ moe.id }}</td>
                <td>{{ moe.nomMoe }}</td>
                <td>{{ moe.prenomMoe }}</td>
                <td>{{ moe.telMoe }}</td>
                <td>{{ moe.mailMoe }}</td>
                <td>
                    <a class="btn btn-primary" href="{{ path('moe_show', {'id': moe.id}) }}" role="button">Voir</a>
                    <a class="btn btn-warning" href="{{ path('moe_edit', {'id': moe.id}) }}" role="button">Mettre à jour</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
    
{% endblock %}
