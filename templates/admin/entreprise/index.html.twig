{% extends 'base.html.twig' %}

{% block title %}Liste des entreprises{% endblock %}

{% block body %}
    <h1>Liste des entreprises</h1>

    <div class="divButton">
        <a class="btn btn-primary" href="{{ path('entreprise_new') }}" role="button">Créer nouvelle entreprise</a>
        <a class="btn btn-secondary" href="{{ path('admin_home') }}" role="button">Retour à l'accueil</a>
    </div>

    <div class="container">
    {% for message in app.flashes('message')%}
    <div class="alert alert-success" role="alert">{{ message }}</div>
    {% endfor %}
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom_entreprise</th>
                <th>Num_rue_entreprise</th>
                <th>Nom_rue_entreprise</th>
                <th>Cp_entreprise</th>
                <th>Ville_entreprise</th>
                <th>Role</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for entreprise in entreprises %}
            <tr>
                <td>{{ entreprise.id }}</td>
                <td>{{ entreprise.nomEntreprise }}</td>
                <td>{{ entreprise.numRueEntreprise }}</td>
                <td>{{ entreprise.nomRueEntreprise }}</td>
                <td>{{ entreprise.cpEntreprise }}</td>
                <td>{{ entreprise.villeEntreprise }}</td>
                <td>{{ entreprise.role }}</td>
                <td>
                    <a class="btn btn-primary" href="{{ path('entreprise_show', {'id': entreprise.id}) }}" role="button">Voir</a>
                    <a class="btn btn-warning" href="{{ path('entreprise_edit', {'id': entreprise.id}) }}" role="button">Mettre à jour</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
    
{% endblock %}
