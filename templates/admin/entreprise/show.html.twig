{% extends 'base.html.twig' %}

{% block title %}Entreprise{% endblock %}

{% block body %}
    <h1>Entreprise</h1>

    <div class="divButtonEditCctp">
        <a class="btn btn-primary" href="{{ path('entreprise_index') }}" role="button">Retour liste entreprise</a>
        <a class="btn btn-warning" href="{{ path('entreprise_edit', {'id': entreprise.id}) }}" role="button">Mettre à jour</a>
        <a class="btn btn-secondary" href="{{ path('admin_home') }}" role="button">Retour à l'accueil</a>
    </div>

    <div class="container">
    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ entreprise.id }}</td>
            </tr>
            <tr>
                <th>Nom_entreprise</th>
                <td>{{ entreprise.nomEntreprise }}</td>
            </tr>
            <tr>
                <th>Num_rue_entreprise</th>
                <td>{{ entreprise.numRueEntreprise }}</td>
            </tr>
            <tr>
                <th>Nom_rue_entreprise</th>
                <td>{{ entreprise.nomRueEntreprise }}</td>
            </tr>
            <tr>
                <th>Cp_entreprise</th>
                <td>{{ entreprise.cpEntreprise }}</td>
            </tr>
            <tr>
                <th>Ville_entreprise</th>
                <td>{{ entreprise.villeEntreprise }}</td>
            </tr>
        </tbody>
    </table>
    {{ include('admin/entreprise/_delete_form.html.twig') }}
    </div>

{% endblock %}
