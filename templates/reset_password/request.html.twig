{% extends 'base.html.twig' %}
{% block title %}Mot de passe oublié{% endblock %}
{% block body %}
<div class="card shadow" style="width:100%;max-width:420px;">
<div class="card-body p-4">
<h4 class="mb-3 fw-bold text-center">Mot de passe oublié</h4>
{% for msg in app.flashes('reset_password_error') %}<div class="alert alert-danger">{{ msg }}</div>{% endfor %}
{{ form_start(requestForm) }}{{ form_widget(requestForm) }}
<button type="submit" class="btn btn-primary w-100 mt-3">Envoyer le lien</button>
{{ form_end(requestForm) }}
<div class="text-center mt-3"><a href="{{ path('app_login') }}" class="text-muted small">Retour à la connexion</a></div>
</div></div>
{% endblock %}
