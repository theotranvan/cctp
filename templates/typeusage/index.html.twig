{% extends 'base.html.twig' %}

{% block title %}Typeusage index{% endblock %}

{% block body %}
    <h1>Typeusage index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom_usage</th>
                <th>Color</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for typeusage in typeusages %}
            <tr>
                <td>{{ typeusage.id }}</td>
                <td>{{ typeusage.nomUsage }}</td>
                <td>{{ typeusage.color }}</td>
                <td>
                    <a href="{{ path('app_typeusage_show', {'id': typeusage.id}) }}">show</a>
                    <a href="{{ path('app_typeusage_edit', {'id': typeusage.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_typeusage_new') }}">Create new</a>
{% endblock %}
